# The public base URL of the Flask API, without a trailing slash.
# Local: http://localhost:5000
# Vercel: https://your-api.up.railway.app
NEXT_PUBLIC_API_URL=http://localhost:5000

# Optional: used for displaying dates and times in the UI.
NEXT_PUBLIC_APP_TIMEZONE=Asia/Colombo

# Multi-tenant subdomains: apex domain(s) hosting institution subdomains.
# abc.example.com -> tenant "abc". Leave empty for single-domain deployments.
# Leave this UNSET for local development: kks.localhost:3000 and
# localhost:3000?tenant=kks are detected automatically. Set it in production
# only, so generated dashboard links point at the real apex domain.
# NEXT_PUBLIC_ROOT_DOMAIN=example.com
